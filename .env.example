APP_ENV=production
APP_URL=https://dns.example.net
# Generate using: php bin/arzoie key:generate
APP_KEY=
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arzoiedns
DB_USERNAME=arzoiedns
DB_PASSWORD=
# Absolute paths outside the public document root. Signer/worker owns these.
STATE_PATH=/var/lib/arzoiedns
SIGNER_PATH=/var/lib/arzoiedns/signer
SSH_KEY_PATH=/var/lib/arzoiedns/ssh/id_ed25519
# Optional authorized_keys source restriction, e.g. 192.0.2.10/32
CONTROL_CIDR=
